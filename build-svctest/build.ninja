  COMMAND = cd /home/user/Hadron/build-svctest && /usr/bin/cmake --regenerate-during-build -S/home/user/Hadron -B/home/user/Hadron/build-svctest
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

