#include <winver.h>

1 ICON "@HADRON_ICON@"
1 24 "@GEN_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @V_MAJOR@,@V_MINOR@,@V_PATCH@,0
PRODUCTVERSION @V_MAJOR@,@V_MINOR@,@V_PATCH@,0
FILEOS         0x40004L
FILETYPE       0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "floration"
      VALUE "FileDescription",  "@EXE_DESC@"
      VALUE "FileVersion",      "@PROJECT_VERSION@"
      VALUE "InternalName",     "@EXE_NAME@"
      VALUE "OriginalFilename", "@EXE_NAME@.exe"
      VALUE "ProductName",      "Hadron"
      VALUE "ProductVersion",   "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 0x04B0
  END
END
